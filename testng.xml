<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Mobile Test Suite" verbose="2">

    <listeners>
        <listener class-name="com.nidhinsai.mobile.listeners.MobileTestListener"/>
    </listeners>

    <test name="Android Login Tests">
        <parameter name="platform" value="android"/>
        <classes>
            <class name="com.nidhinsai.mobile.tests.LoginTest"/>
            <class name="com.nidhinsai.mobile.tests.HomeScreenTest"/>
        </classes>
    </test>

</suite>